# ArcPay Backend Port
PORT=3001

# Arc Testnet RPC URL
ARC_TESTNET_RPC=https://rpc.testnet.arc.io

# Deployed ArcMilestoneEscrow contract address on Arc Testnet
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# SQLite Database path (optional, defaults to ./data/arcpay.sqlite)
DATABASE_PATH=./data/arcpay.sqlite

# Indexer poll interval in milliseconds (10000ms recommended for public RPC rate limits)
POLL_INTERVAL_MS=10000

# Optional starting block for indexing events (leave unset to index from recent blocks)
# INDEXER_START_BLOCK=17340000
