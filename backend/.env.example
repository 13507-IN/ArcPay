# ArcPay Backend Port
PORT=3001

# Arc Testnet RPC URL
ARC_TESTNET_RPC=https://rpc.testnet.arc.io

# Deployed ArcMilestoneEscrow contract address on Arc Testnet
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# MongoDB Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=arcpay

# Comma-separated allowed origins (localhost & *.vercel.app are permitted automatically)
# CORS_ORIGINS=https://your-arcpay-app.vercel.app

# Indexer poll interval in milliseconds
POLL_INTERVAL_MS=10000

# Set this to the contract deployment block to avoid scanning unrelated Arc history.
INDEXER_START_BLOCK=0

# Free High-Limit AI Providers for Deliverable Verification (pick any one):
# CEREBRAS_API_KEY=your_cerebras_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional GitHub Personal Access Token (raises rate limit from 60 to 5000 req/hr)
# GITHUB_TOKEN=your_github_token_here
