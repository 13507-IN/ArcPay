# ArcPay Backend Port
PORT=3001

# Arc Testnet RPC URL
ARC_TESTNET_RPC=https://rpc.testnet.arc.io

# Deployed ArcMilestoneEscrow contract address on Arc Testnet
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Database Type: "sqlite" (default) or "mongodb"
DATABASE_TYPE=sqlite

# SQLite Database path (used when DATABASE_TYPE=sqlite)
DATABASE_PATH=./data/arcpay.sqlite

# MongoDB Database Configuration (used when DATABASE_TYPE=mongodb or MONGODB_URI is provided)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=arcpay

# Indexer poll interval in milliseconds
POLL_INTERVAL_MS=3000

# Set this to the contract deployment block to avoid scanning unrelated Arc history.
# Use 0 only if you intentionally want a full-history backfill.
INDEXER_START_BLOCK=0
