# ==============================================================================
# ArcPay Backend .gitignore (Express, TypeScript, SQLite)
# ==============================================================================

# Dependencies
node_modules/

# TypeScript Build Output
dist/
*.tsbuildinfo

# Local SQLite Database Files
data/*.sqlite*
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Environment Variables
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
logs/
*.log
